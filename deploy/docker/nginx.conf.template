# Serves the single-page app and proxies the API (same origin, so no CORS needed).
# nginx renders this template at start-up, substituting environment variables it defines
# (API_UPSTREAM); nginx variables such as $host are left untouched.
upstream sovereign_api {
    server ${API_UPSTREAM};
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 25m;  # document uploads (RAG_MAX_UPLOAD_MB defaults to 10)

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Streamed agent runs (Server-Sent Events): never buffer.
    location = /api/v1/agent/query/stream {
        proxy_pass http://sovereign_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    location /api/ {
        proxy_pass http://sovereign_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # /metrics stays internal: Prometheus scrapes the API directly.
    # MCP clients (Streamable HTTP, code mode); scripts may run up to MCP_CODE_TIMEOUT_SECONDS.
    location = /mcp {
        proxy_pass http://sovereign_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 330s;
    }

    location = /metrics {
        return 404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
