# ======================================================================================
# connections.env: paste the links and keys of the platforms you use, in one place.
# Generated by `python -m scripts.connections --markdown`; copy it with
# `python -m scripts.connections --init` (creates connections.env, never committed).
#
# 1. Fill in the REQUIRED lines of a platform (leave platforms you do not use empty).
# 2. Restart the API. 3. Run `python -m scripts.connections` to see the checklist,
#    or open Integrations in the app. Values here override .env.
# ======================================================================================

# false = use the real platforms below; true = synthetic demo data everywhere.
DEMO_MODE=false

# ======================================================================================
# CORE (JIRA, GITHUB, KEKA, GMAIL)
# ======================================================================================

# --- Jira Cloud ---
# Where to get it: API token from id.atlassian.com → Security → API tokens; base URL https://<site>.atlassian.net
# Docs: https://developer.atlassian.com/cloud/jira/platform/rest/v3/
JIRA_BASE_URL=    # required
JIRA_EMAIL=    # required
JIRA_API_TOKEN=    # required
JIRA_TIMEOUT_SECONDS=30.0
JIRA_STORY_POINTS_FIELD=customfield_10016

# --- GitHub ---
# Where to get it: Fine-grained token: read PRs, contents, actions, checks (+ PR write for comments)
# Docs: https://docs.github.com/rest
GITHUB_TOKEN=    # required
GITHUB_API_URL=https://api.github.com
GITHUB_ALLOWED_REPOS=[]
GITHUB_TIMEOUT_SECONDS=30.0

# --- Keka HRMS ---
# Where to get it: Keka admin → Integrations → API access (client id/secret + API key)
# Docs: https://developers.keka.com/
KEKA_BASE_URL=    # required
KEKA_CLIENT_ID=    # required
KEKA_CLIENT_SECRET=    # required
KEKA_API_KEY=    # required
KEKA_TOKEN_URL=https://login.keka.com/connect/token
KEKA_TIMEOUT_SECONDS=30.0

# --- Gmail (drafts) ---
# Where to get it: Google Cloud OAuth client; servers set the refresh token, local dev runs `python -m scripts.gmail_auth` once to create GMAIL_TOKEN_FILE
# Docs: https://developers.google.com/gmail/api
GMAIL_CLIENT_ID=    # required
GMAIL_CLIENT_SECRET=    # required
GMAIL_REFRESH_TOKEN=    # required
GMAIL_REDIRECT_URI=
GMAIL_CREDENTIALS_FILE=C:\Users\Rohit\OneDrive\Desktop\credentials.json
GMAIL_TOKEN_FILE=C:\Users\Rohit\OneDrive\Desktop\token.json
GMAIL_ALLOWED_RECIPIENT_DOMAINS=[]

# ======================================================================================
# ISSUE TRACKERS & CODE HOSTING
# ======================================================================================

# --- Linear ---
# Where to get it: Linear → Settings → API → Personal API keys; LINEAR_TEAM_KEYS limits teams (e.g. ["ENG"])
# Docs: https://developers.linear.app/docs/graphql/working-with-the-graphql-api
LINEAR_API_KEY=    # required
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_TEAM_KEYS=[]

# --- GitLab ---
# Where to get it: Personal/project access token with read_api scope; self-managed: set GITLAB_URL
# Docs: https://docs.gitlab.com/api/rest/
GITLAB_TOKEN=    # required
GITLAB_URL=https://gitlab.com
GITLAB_PROJECTS=[]

# --- Azure DevOps ---
# Where to get it: User settings → Personal access tokens (Work Items: Read, Code: Read)
# Docs: https://learn.microsoft.com/rest/api/azure/devops/
AZURE_DEVOPS_ORG_URL=    # required
AZURE_DEVOPS_PAT=    # required
AZURE_DEVOPS_PROJECTS=[]

# --- Asana ---
# Where to get it: Asana → My settings → Apps → Developer console → Personal access token
# Docs: https://developers.asana.com/reference/rest-api-reference
ASANA_TOKEN=    # required
ASANA_PROJECTS=[]

# --- ClickUp ---
# Where to get it: ClickUp → Settings → Apps → API token; CLICKUP_LISTS = list ids to read
# Docs: https://developer.clickup.com/reference
CLICKUP_TOKEN=    # required
CLICKUP_LISTS=[]

# --- Bitbucket Cloud ---
# Where to get it: Atlassian account → API tokens (Bitbucket scopes: repository, pull request read)
# Docs: https://developer.atlassian.com/cloud/bitbucket/rest/
BITBUCKET_WORKSPACE=    # required
BITBUCKET_USERNAME=    # required
BITBUCKET_API_TOKEN=    # required
BITBUCKET_REPOS=[]

# ======================================================================================
# ENGINEERING OPERATIONS
# ======================================================================================

# --- PagerDuty ---
# Where to get it: PagerDuty → Integrations → API Access Keys (read-only key)
# Docs: https://developer.pagerduty.com/api-reference/
PAGERDUTY_API_KEY=    # required
PAGERDUTY_SERVICES=[]

# --- Opsgenie ---
# Where to get it: Opsgenie → Settings → API key management (read access); EU accounts set OPSGENIE_API_URL
# Docs: https://docs.opsgenie.com/docs/alert-api
OPSGENIE_API_KEY=    # required
OPSGENIE_API_URL=https://api.opsgenie.com

# --- Sentry ---
# Where to get it: Sentry → Settings → Auth Tokens (scopes: project:read, event:read); self-hosted: SENTRY_URL
# Docs: https://docs.sentry.io/api/
SENTRY_TOKEN=    # required
SENTRY_ORG=    # required
SENTRY_URL=https://sentry.io

# --- Jenkins ---
# Where to get it: Jenkins → your user → Configure → API Token
# Docs: https://www.jenkins.io/doc/book/using/remote-access-api/
JENKINS_URL=    # required
JENKINS_USERNAME=    # required
JENKINS_API_TOKEN=    # required
JENKINS_JOBS=[]

# --- Argo CD ---
# Where to get it: argocd account generate-token --account <read-only account>
# Docs: https://argo-cd.readthedocs.io/en/stable/developer-guide/api-docs/
ARGOCD_URL=    # required
ARGOCD_TOKEN=    # required

# --- SonarQube / SonarCloud ---
# Where to get it: My Account → Security → Generate token (Browse permission); self-hosted: SONARQUBE_URL
# Docs: https://docs.sonarsource.com/sonarqube-server/latest/extension-guide/web-api/
SONARQUBE_TOKEN=    # required
SONARQUBE_URL=https://sonarcloud.io

# --- Datadog ---
# Where to get it: Datadog → Organization Settings → API Keys + Application Keys (scopes incident_read, monitors_read); EU or other regions set DATADOG_SITE (e.g. datadoghq.eu)
# Docs: https://docs.datadoghq.com/api/latest/
DATADOG_API_KEY=    # required
DATADOG_APP_KEY=    # required
DATADOG_SITE=datadoghq.com

# --- ServiceNow ---
# Where to get it: A ServiceNow user with the itil (read) role; instance URL https://<company>.service-now.com
# Docs: https://developer.servicenow.com/dev.do#!/reference/api/latest/rest/c_TableAPI
SERVICENOW_INSTANCE_URL=    # required
SERVICENOW_USERNAME=    # required
SERVICENOW_PASSWORD=    # required

# ======================================================================================
# CLOUD (RESOURCES, COST, HEALTH, SECURITY)
# ======================================================================================

# --- Amazon Web Services ---
# Where to get it: IAM user or role with a read-only policy: tag:GetResources, ec2:DescribeInstances, ec2:DescribeInstanceStatus, ec2:DescribeVolumes, rds:DescribeDBInstances, cloudwatch:DescribeAlarms, cloudwatch:GetMetricStatistics, securityhub:GetFindings (+ ce:GetCostAndUsage, ce:GetCostForecast if AWS_COST_EXPLORER_ENABLED). Tag resources project=<KEY> (and purpose / environment / owner)
# Docs: https://docs.aws.amazon.com/resourcegroupstagging/latest/APIReference/API_GetResources.html
AWS_ACCESS_KEY_ID=    # required
AWS_SECRET_ACCESS_KEY=    # required
AWS_SESSION_TOKEN=
AWS_REGIONS=["us-east-1"]
AWS_COST_EXPLORER_ENABLED=false
CLOUD_PROJECT_TAG_KEY=project

# --- Microsoft Azure ---
# Where to get it: Entra ID app registration (client secret) with Reader, Cost Management Reader, Monitoring Reader and Security Reader on the subscription. Tag resources project=<KEY> (and purpose / environment / owner)
# Docs: https://learn.microsoft.com/azure/governance/resource-graph/overview
AZURE_TENANT_ID=    # required
AZURE_CLIENT_ID=    # required
AZURE_CLIENT_SECRET=    # required
AZURE_SUBSCRIPTION_ID=    # required

# --- Google Cloud ---
# Where to get it: Service account key (GOOGLE_SERVICE_ACCOUNT_FILE) with Cloud Asset Viewer, Monitoring Viewer and Security Center Findings Viewer on each project in GCP_PROJECT_IDS. Label resources project=<key in lowercase> (and purpose / environment / owner). Cost needs a BigQuery billing export and is not shown
# Docs: https://cloud.google.com/asset-inventory/docs/reference/rest/v1/TopLevel/searchAllResources
GOOGLE_SERVICE_ACCOUNT_FILE=    # required
GCP_PROJECT_IDS=[]    # required

# ======================================================================================
# CUSTOMER SUPPORT
# ======================================================================================

# --- Zendesk ---
# Where to get it: Zendesk Admin Center → Apps and integrations → Zendesk API → enable token access, add a token; tag tickets with the project key (lowercase)
# Docs: https://developer.zendesk.com/api-reference/ticketing/ticket-management/search/
ZENDESK_SUBDOMAIN=    # required
ZENDESK_EMAIL=    # required
ZENDESK_API_TOKEN=    # required

# ======================================================================================
# HR SYSTEMS
# ======================================================================================

# --- BambooHR ---
# Where to get it: BambooHR → your name → API Keys (a user who can see time off)
# Docs: https://documentation.bamboohr.com/reference/get-a-list-of-whos-out-1
BAMBOOHR_COMPANY=    # required
BAMBOOHR_API_KEY=    # required

# --- Zoho People ---
# Where to get it: api-console.zoho.com → Self Client → scope ZOHOPEOPLE.forms.READ → refresh token; regional accounts use their domain (e.g. accounts.zoho.in)
# Docs: https://www.zoho.com/people/api/overview.html
ZOHO_CLIENT_ID=    # required
ZOHO_CLIENT_SECRET=    # required
ZOHO_REFRESH_TOKEN=    # required
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PEOPLE_URL=https://people.zoho.com

# --- Darwinbox ---
# Where to get it: Darwinbox admin → API settings (leave action API key + basic-auth user)
# Docs: https://darwinbox.com/
DARWINBOX_URL=    # required
DARWINBOX_USERNAME=    # required
DARWINBOX_PASSWORD=    # required
DARWINBOX_API_KEY=    # required

# --- Workday ---
# Where to get it: Create a custom report of time off (Employee_ID, Worker, Start_Date, End_Date, Time_Off_Type, Status) enabled as a web service; use an integration system user
# Docs: https://community.workday.com/
WORKDAY_LEAVE_REPORT_URL=    # required
WORKDAY_USERNAME=    # required
WORKDAY_PASSWORD=    # required

# ======================================================================================
# FINANCE & ACCOUNTING
# ======================================================================================

# --- Zoho Books ---
# Where to get it: Same Zoho self client with scope ZohoBooks.projects.READ,ZohoBooks.expenses.READ; organization id from Settings → Organization profile
# Docs: https://www.zoho.com/books/api/v3/
# ZOHO_CLIENT_ID (set above)
# ZOHO_CLIENT_SECRET (set above)
# ZOHO_REFRESH_TOKEN (set above)
ZOHO_BOOKS_ORGANIZATION_ID=    # required
ZOHO_BOOKS_URL=https://www.zohoapis.com/books/v3

# --- Tally Prime ---
# Where to get it: Tally Prime → F1 Help → Settings → Connectivity: enable the HTTP server (port 9000)
# Docs: https://help.tallysolutions.com/integration-with-tallyprime/
TALLY_URL=    # required
TALLY_COMPANY=

# --- SAP S/4HANA (OData) ---
# Where to get it: Expose a CDS view / OData service with project, budget, actual and currency; a communication user with read access; map the field names if they differ
# Docs: https://api.sap.com/
SAP_ODATA_URL=    # required
SAP_USERNAME=    # required
SAP_PASSWORD=    # required
SAP_PROJECT_FIELD=Project
SAP_BUDGET_FIELD=Budget
SAP_ACTUAL_FIELD=Actual
SAP_CURRENCY_FIELD=Currency

# ======================================================================================
# CRM
# ======================================================================================

# --- Salesforce ---
# Where to get it: External Client App / Connected App with the OAuth client-credentials flow and a read-only run-as user; add an Opportunity field holding the Jira project key
# Docs: https://developer.salesforce.com/docs/atlas.en-us.api_rest.meta/api_rest/
SALESFORCE_URL=    # required
SALESFORCE_CLIENT_ID=    # required
SALESFORCE_CLIENT_SECRET=    # required
SALESFORCE_API_VERSION=v61.0
SALESFORCE_PROJECT_FIELD=Project_Key__c

# --- HubSpot ---
# Where to get it: Settings → Integrations → Private apps (scope crm.objects.deals.read); add a deal property holding the Jira project key
# Docs: https://developers.hubspot.com/docs/api/crm/deals
HUBSPOT_TOKEN=    # required
HUBSPOT_PROJECT_PROPERTY=project_key

# ======================================================================================
# DOCUMENT SOURCES (KNOWLEDGE BASE SYNC)
# ======================================================================================

# --- Confluence Cloud ---
# Where to get it: Atlassian API token (can reuse the Jira one); CONFLUENCE_URL=https://<site>.atlassian.net/wiki; page read-restrictions are mirrored (restricted pages become admin-only)
# Docs: https://developer.atlassian.com/cloud/confluence/rest/v2/
CONFLUENCE_URL=    # required
CONFLUENCE_EMAIL=    # required
CONFLUENCE_API_TOKEN=    # required
CONFLUENCE_SPACES=[]    # required

# --- Notion ---
# Where to get it: notion.so/my-integrations → internal integration; share the pages to sync with it
# Docs: https://developers.notion.com/reference/intro
NOTION_TOKEN=    # required
NOTION_VERSION=2022-06-28

# --- SharePoint / OneDrive ---
# Where to get it: Entra ID app registration with application permission Sites.Selected (granted to the site) or Sites.Read.All; reads .md/.txt/.pdf/.docx in the library root
# Docs: https://learn.microsoft.com/graph/api/resources/sharepoint
MS_TENANT_ID=    # required
MS_CLIENT_ID=    # required
MS_CLIENT_SECRET=    # required
SHAREPOINT_SITE_ID=    # required
SHAREPOINT_DRIVE_ID=

# --- Google Drive ---
# Where to get it: Service account JSON key; share the folder with the service account (or use domain-wide delegation with GOOGLE_DELEGATED_USER)
# Docs: https://developers.google.com/drive/api/reference/rest/v3
# GOOGLE_SERVICE_ACCOUNT_FILE (set above)
GOOGLE_DRIVE_FOLDER_ID=    # required
GOOGLE_DELEGATED_USER=

# ======================================================================================
# CALENDARS
# ======================================================================================

# --- Google Calendar ---
# Where to get it: Service account with domain-wide delegation (scope calendar.readonly) impersonating GOOGLE_DELEGATED_USER; free/busy works for colleagues in the same Workspace
# Docs: https://developers.google.com/calendar/api/v3/reference
# GOOGLE_SERVICE_ACCOUNT_FILE (set above)
# GOOGLE_DELEGATED_USER (set above)
GOOGLE_CALENDAR_ID=primary

# --- Outlook / Microsoft 365 calendar ---
# Where to get it: Entra ID app with application permission Calendars.ReadBasic.All (or Calendars.Read); OUTLOOK_MAILBOX is the calendar used for events and getSchedule
# Docs: https://learn.microsoft.com/graph/api/calendar-getschedule
# MS_TENANT_ID (set above)
# MS_CLIENT_ID (set above)
# MS_CLIENT_SECRET (set above)
OUTLOOK_MAILBOX=    # required

# ======================================================================================
# MEETING TRANSCRIPTS
# ======================================================================================

# --- Zoom ---
# Where to get it: Zoom Marketplace → Server-to-Server OAuth app (scope cloud_recording:read:list_user_recordings); enable cloud recording audio transcripts
# Docs: https://developers.zoom.us/docs/api/
ZOOM_ACCOUNT_ID=    # required
ZOOM_CLIENT_ID=    # required
ZOOM_CLIENT_SECRET=    # required

# --- Microsoft Teams transcripts ---
# Where to get it: Entra ID app with OnlineMeetingTranscript.Read.All plus an application access policy for the organizer; transcription must be on in the meetings
# Docs: https://learn.microsoft.com/graph/api/resources/calltranscript
# MS_TENANT_ID (set above)
# MS_CLIENT_ID (set above)
# MS_CLIENT_SECRET (set above)
TEAMS_ORGANIZER_USER=    # required

# --- Google Meet transcripts ---
# Where to get it: Service account with domain-wide delegation (scope meetings.space.readonly) impersonating the meeting organizer; Meet transcripts must be on
# Docs: https://developers.google.com/meet/api/reference/rest
# GOOGLE_SERVICE_ACCOUNT_FILE (set above)
# GOOGLE_DELEGATED_USER (set above)

# ======================================================================================
# CHAT (SLACK / TEAMS)
# ======================================================================================

# --- Slack ---
# Where to get it: api.slack.com/apps → bot scopes app_mentions:read, chat:write, im:history, users:read, channels:history, groups:history (to index project channels listed in a project's slack_channels link), users:read.email; Event Subscriptions → https://<host>/api/v1/chat/slack/events (app_mention, message.im); Interactivity → https://<host>/api/v1/chat/slack/interactions
# Docs: https://api.slack.com/apis/events-api
SLACK_BOT_TOKEN=    # required
SLACK_SIGNING_SECRET=    # required
SLACK_DIGEST_CHANNEL=

# --- Microsoft Teams chat ---
# Where to get it: Teams → channel → Manage → Outgoing webhook to https://<host>/api/v1/chat/teams/messages (copy the security token); a Workflows 'post to channel when a webhook request is received' URL for answers; MS_* settings map senders to platform users
# Docs: https://learn.microsoft.com/microsoftteams/platform/webhooks-and-connectors/how-to/add-outgoing-webhook
TEAMS_OUTGOING_WEBHOOK_SECRET=    # required
TEAMS_WORKFLOW_WEBHOOK_URL=    # required
