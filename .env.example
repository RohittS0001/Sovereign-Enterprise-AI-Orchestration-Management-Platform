# Application
APP_NAME=Sovereign Enterprise AI Orchestration & Management Platform
# development | test | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# stdout | stderr (stdio transports such as the MCP server force stderr)
LOG_STREAM=stdout

# Backend
HOST=127.0.0.1
PORT=8000
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# Database
# PostgreSQL (recommended; `docker compose up -d db` starts one):
#   DATABASE_URL=postgresql://sovereign:sovereign@localhost:5432/sovereign
# Quick local alternative without Docker:
#   DATABASE_URL=sqlite:///./data/app.db
# Then apply migrations:  python -m alembic upgrade head
# And create the first admin:  python -m scripts.create_admin --email you@company.com --name "You"
DATABASE_URL=
DATABASE_ECHO=false

# Security / auth
# Required (32+ chars) in staging/production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, a temporary key is used and sessions end on restart.
JWT_SECRET_KEY=
JWT_ISSUER=sovereign-platform
JWT_AUDIENCE=sovereign-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_PER_MINUTE=30

# Local LLMs — served by Ollama (default) or any OpenAI-compatible server (vLLM, llama.cpp).
# Ollama quick start:  ollama pull qwen3:8b   then set LLM1_MODEL_NAME=qwen3:8b
# Pick a model with reliable JSON / tool-use output for LLM 1.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
# Only for OpenAI-compatible servers that require a key.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0

# LLM 1 - Operations (planning and tool selection). Required for the agent.
LLM1_MODEL_PATH=
LLM1_MODEL_NAME=

# LLM 2 - Reporting (answers and reports). Empty = reuse LLM 1.
LLM2_MODEL_PATH=
LLM2_MODEL_NAME=

# Agent limits
AGENT_MAX_ITERATIONS=4
AGENT_MAX_STEPS=10
AGENT_OBSERVATION_MAX_CHARS=6000

# Tool execution
TOOL_TIMEOUT_SECONDS=30
TOOL_READ_RETRIES=2
TOOL_RETRY_BACKOFF_SECONDS=0.5

# Human approval of agent write actions
APPROVAL_TTL_HOURS=72
# false = "four eyes": someone other than the requester must approve.
APPROVAL_ALLOW_SELF_APPROVAL=true
# JSON list of write tools the agent may run without approval, e.g. ["jira.add_comment"]
APPROVAL_EXEMPT_TOOLS=[]

# Guardrails: also mask email addresses and phone numbers before they reach the LLM.
GUARDRAILS_REDACT_CONTACT_INFO=false

# Embeddings for document search. auto = use the LLM server if EMBEDDING_MODEL_NAME is set
# (e.g. `ollama pull nomic-embed-text` or bge-m3), otherwise an offline hashing embedder.
# Changing the model requires re-ingesting documents (vectors are compared per model).
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL_NAME=
EMBEDDING_BASE_URL=

# Retrieval
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_CANDIDATE_K=40
RAG_MAX_CHUNKS_PER_DOCUMENT=3
RAG_MAX_UPLOAD_MB=10
# Optional local cross-encoder reranker (text-embeddings-inference /rerank API).
RERANKER_URL=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_TIMEOUT_SECONDS=30
# Custom field holding story points (open an issue's JSON in Jira to find yours).
JIRA_STORY_POINTS_FIELD=customfield_10016

# Gmail
# Option A (servers): OAuth client + refresh token from env.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
# Option B (local dev): run `python -m scripts.gmail_auth` once to create the token file.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Only allow Gmail drafts to these recipient domains (JSON list; empty = any).
GMAIL_ALLOWED_RECIPIENT_DOMAINS=[]

# Keka (HRMS) — API key integration from Keka admin settings.
# Base URL: https://<company>.keka.com/api/v1  (sandbox: https://<company>.kekademo.com/api/v1
# with KEKA_TOKEN_URL=https://login.kekademo.com/connect/token)
KEKA_BASE_URL=
KEKA_TOKEN_URL=https://login.keka.com/connect/token
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=
KEKA_TIMEOUT_SECONDS=30

# GitHub — fine-grained token with read access to PRs, contents, actions, checks
# (plus PR write for comments). GitHub Enterprise: GITHUB_API_URL=https://<host>/api/v3
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=30
# JSON list of "owner/repo" the agent may access; empty = everything the token can see.
GITHUB_ALLOWED_REPOS=[]

# Demo mode: serve every integration from the built-in synthetic dataset (no credentials).
DEMO_MODE=false

# Analytics & weekly reports
ANALYTICS_CACHE_SECONDS=60
ANALYTICS_DEFAULT_CAPACITY_POINTS=10
REPORT_SCHEDULE_ENABLED=false
# 0 = Monday ... 6 = Sunday; hour in UTC (3 = 08:30 IST)
REPORT_SCHEDULE_WEEKDAY=0
REPORT_SCHEDULE_HOUR_UTC=3

# Per-user daily agent token quota (0 = unlimited)
AGENT_DAILY_TOKEN_QUOTA=0

# Observability: Prometheus scrapes /metrics; set a token to require "Authorization: Bearer <token>".
METRICS_ENABLED=true
METRICS_TOKEN=
# OpenTelemetry traces over OTLP/HTTP (Jaeger, Grafana Tempo, an OTel collector). Empty = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sovereign-api

# Docker Compose only (docker-compose.yml reads these from .env; defaults suit a local trial)
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign
POSTGRES_DB=sovereign
# Migrate + seed the demo dataset and one user per role on API start (password below).
SEED_DEMO=true
DEMO_PASSWORD=
WEB_CONCURRENCY=2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# MCP server (code mode): POST /mcp (Streamable HTTP) or `python -m scripts.mcp_stdio`.
# Clients authenticate with a personal access token (Assistant page → MCP access).
MCP_ENABLED=true
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_CODE_TIMEOUT_SECONDS=30
MCP_MAX_STEPS=200000
MCP_MAX_TOOL_CALLS=50
MCP_MAX_OUTPUT_CHARS=20000
MCP_TOKEN_MAX_DAYS=90

# ---- Connectors (see docs/integrations.md; `python -m scripts.connections` shows what's missing)
CONNECTOR_TIMEOUT_SECONDS=30
# Issue trackers & code hosting
LINEAR_API_KEY=
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_TEAM_KEYS=[]
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com
GITLAB_PROJECTS=[]
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_PROJECTS=[]
ASANA_TOKEN=
ASANA_PROJECTS=[]
CLICKUP_TOKEN=
CLICKUP_LISTS=[]
BITBUCKET_WORKSPACE=
BITBUCKET_USERNAME=
BITBUCKET_API_TOKEN=
BITBUCKET_REPOS=[]
# Engineering operations (scope each project via its links: pagerduty_services, sentry_projects, ...)
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICES=[]
OPSGENIE_API_KEY=
OPSGENIE_API_URL=https://api.opsgenie.com
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_URL=https://sentry.io
JENKINS_URL=
JENKINS_USERNAME=
JENKINS_API_TOKEN=
JENKINS_JOBS=[]
ARGOCD_URL=
ARGOCD_TOKEN=
SONARQUBE_URL=https://sonarcloud.io
SONARQUBE_TOKEN=
# HR (leave feeds team capacity; members match by hr_employee_id or name)
BAMBOOHR_COMPANY=
BAMBOOHR_API_KEY=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_PEOPLE_URL=https://people.zoho.com
DARWINBOX_URL=
DARWINBOX_USERNAME=
DARWINBOX_PASSWORD=
DARWINBOX_API_KEY=
WORKDAY_LEAVE_REPORT_URL=
WORKDAY_USERNAME=
WORKDAY_PASSWORD=
# Finance (budget vs actuals → earned value; projects match by links.cost_centers, key or name)
ZOHO_BOOKS_URL=https://www.zohoapis.com/books/v3
ZOHO_BOOKS_ORGANIZATION_ID=
TALLY_URL=
TALLY_COMPANY=
SAP_ODATA_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_PROJECT_FIELD=Project
SAP_BUDGET_FIELD=Budget
SAP_ACTUAL_FIELD=Actual
SAP_CURRENCY_FIELD=Currency
