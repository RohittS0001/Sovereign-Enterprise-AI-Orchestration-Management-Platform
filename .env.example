# Application
APP_NAME=Sovereign Enterprise AI Orchestration & Management Platform
# development | test | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# Backend
HOST=127.0.0.1
PORT=8000
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# Database
DATABASE_URL=

# LLM 1 - Operations
LLM1_MODEL_PATH=
LLM1_MODEL_NAME=

# LLM 2 - Reporting
LLM2_MODEL_PATH=
LLM2_MODEL_NAME=

# Embedding model
EMBEDDING_MODEL_NAME=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_TIMEOUT_SECONDS=30

# Gmail
# Option A (servers): OAuth client + refresh token from env.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
# Option B (local dev): run `python -m scripts.gmail_auth` once to create the token file.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Keka
KEKA_BASE_URL=
KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=

# GitHub
GITHUB_TOKEN=
